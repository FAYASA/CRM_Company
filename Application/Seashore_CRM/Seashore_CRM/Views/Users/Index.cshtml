@using Seashore_CRM.ViewModels.User
@model IEnumerable<UserListViewModel>

@{
    ViewData["Title"] = "User Management";

    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var total = (int)(ViewBag.TotalCount ?? Model.Count());
    var totalPages = (int)(ViewBag.TotalPages ?? 1);

    var currentSortBy = (ViewBag.SortBy as string) ?? "UserName";
    var currentSortOrder = (ViewBag.SortOrder as string) ?? "asc";
}

<div class="container-fluid px-3">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center py-3">
        <div>
            <nav aria-label="breadcrumb" class="small mb-2">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a>
                    </li>
                    <li class="breadcrumb-item active">Users</li>
                </ol>
            </nav>

            <h1 class="h4 fw-bold mb-0 text-dark">
                <i class="bi bi-people-fill me-2"></i> Users
                <span class="badge bg-light text-muted fw-normal ms-2 fs-6">
                    @total total
                </span>
            </h1>

            <p class="small text-muted mb-0">
                Showing @((page - 1) * pageSize + 1) –
                @(Math.Min(page * pageSize, total)) of @total users
            </p>
        </div>

        <div>
            <a asp-action="Create" class="btn btn-danger btn-sm px-3">
                <i class="bi bi-person-plus me-1"></i> New User
            </a>
        </div>
    </div>


    <!-- SEARCH BOX -->
    <div class="mb-3">
        <form method="get" class="input-group input-group-sm">
            <input type="search"
                   name="q"
                   value="@ViewBag.Query"
                   class="form-control"
                   placeholder="Search users..." />
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </form>
    </div>


    <!-- USERS TABLE (DataTables server-side) -->
    @* antiforgery token for AJAX POSTs *@
    @Html.AntiForgeryToken()

    <div class="table-responsive">
        <table id="userTable" class="display table table-striped table-bordered align-middle bg-white" style="width:100%">
            <thead class="table-secondary small text-uppercase">
                <tr>
                    <th>User Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Region</th>
                    <th>Status</th>
                    <th style="width:140px;">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    @* Ensure jQuery is loaded then DataTables (include CDN here to guarantee availability) *@
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(function () {
            var token = $('input[name="__RequestVerificationToken"]').val();

            var table = $('#userTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetUsers", "Users")',
                    type: 'POST',
                    // send antiforgery token as form field so server can read from Request.Form
                    data: function (d) {
                        d.__RequestVerificationToken = token;
                        return d;
                    },
                    dataSrc: function (json) {
                        console.log('GetUsers response', json);
                        // DataTables expects array - if server returned object with 'data', this will pass through
                        if (!json || !json.data) {
                            console.warn('Invalid response from GetUsers');
                            return [];
                        }
                        return json.data;
                    },
                    error: function (xhr, err, thrown) {
                        console.error('DataTables AJAX error', xhr.status, thrown, xhr.responseText);
                    }
                },
                columns: [
                    { data: 'userName' },
                    { data: 'email' },
                    {
                        data: 'role',
                        render: function (data) {
                            if (!data) return '';
                            if (Array.isArray(data)) return data.join(', ');
                            return data;
                        }
                    },
                    { data: 'region', defaultContent: '' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            var edit = '<a href="' + ('/Users/Edit/' + row.id) + '" class="btn btn-outline-primary btn-sm me-1" title="Edit"><i class="bi bi-pencil"></i></a>';
                            var toggleBtn = '<button class="btn btn-sm btn-outline-secondary" onclick="toggleStatus(' + row.id + ');" title="Toggle Status"><i class="bi bi-arrow-repeat"></i></button>';
                            return '<div class="btn-group btn-group-sm">' + edit + toggleBtn + '</div>';
                        }
                    }
                ],
                lengthMenu: [10, 25, 50, 100],
                pageLength: 10,
                initComplete: function () { console.log('DataTable initialized'); },
                drawCallback: function (settings) { console.log('DataTable draw', settings.json); }
            });

            window.toggleStatus = function (id) {
                if (!confirm('Are you sure you want to toggle status for this user?')) return;
                fetch('/Users/ToggleStatus?id=' + id, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                }).then(function (resp) {
                    console.log('ToggleStatus response', resp.status);
                    if (resp.redirected) {
                        // likely unauthenticated/forbidden redirect - open location in console
                        console.warn('ToggleStatus redirected to', resp.url);
                    }
                    if (resp.ok) table.ajax.reload(null, false);
                    else alert('Failed to toggle status');
                }).catch(function (err) { console.error('ToggleStatus failed', err); alert('Failed to toggle status'); });
            };
        });
    </script>


    <!-- PAGINATION -->
    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(page == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(page - 1)"
                       asp-route-q="@ViewBag.Query">
                        Previous
                    </a>
                </li>

                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-q="@ViewBag.Query">@i</a>
                    </li>
                }

                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(page + 1)"
                       asp-route-q="@ViewBag.Query">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }

</div>