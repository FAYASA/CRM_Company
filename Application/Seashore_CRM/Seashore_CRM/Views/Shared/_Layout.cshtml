<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Seashore CRM</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-custom.css" asp-append-version="true" />

    <style>
        .full-width-layout {
            margin-left: 0 !important;
            width: 100% !important;
        }
    </style>
</head>
<body>

    @* --- HEADER --- *@
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <header class="app-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <button class="btn btn-light d-lg-none me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <a class="text-decoration-none d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">
                        <i class="bi bi-buildings-fill"></i>
                    </span>
                    <span class="brand-title d-none d-sm-block">Seashore CRM</span>
                </a>
            </div>

            <div class="d-flex align-items-center gap-3 gap-md-4">

                <div class="d-none d-md-flex align-items-center bg-light rounded-pill px-3 py-2 border">
                    <i class="bi bi-search text-muted"></i>
                    <input type="text" class="form-control border-0 bg-transparent shadow-none ms-2 py-0" placeholder="Search..." style="width: 200px; font-size: 0.875rem;">
                </div>

                <a href="#" class="text-muted position-relative fs-5 text-decoration-none transition-smooth" style="transition: all 0.2s;">
                    <i class="bi bi-bell"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                        <span class="visually-hidden">New alerts</span>
                    </span>
                </a>

                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none gap-2 dropdown-toggle border-start ps-3 py-1 border-light" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; font-weight: 600;">
                            @(User.Identity.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </div>
                        <div class="lh-1 d-none d-sm-block text-start">
                            <p class="mb-0 fw-bold small text-dark">@User.Identity.Name</p>
                            <small class="text-muted" style="font-size: 0.75rem;">Administrator</small>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-3 rounded-3" style="min-width: 200px;">
                        <li><h6 class="dropdown-header">Welcome!</h6></li>
                        <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="#"><i class="bi bi-person text-muted fs-5"></i> My Profile</a></li>
                        <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="#"><i class="bi bi-gear text-muted fs-5"></i> Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 px-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2 rounded-2">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>
        </header>
    }

    <div class="app-layout">

        @* --- SIDEBAR --- *@
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <aside class="app-sidebar d-none d-lg-flex flex-column">
                <div class="sidebar-inner flex-grow-1 overflow-auto">
                    @await Html.PartialAsync("_Sidebar")
                </div>
            </aside>

            <div class="offcanvas offcanvas-start border-0" tabindex="-1" id="mobileSidebar" style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); width: var(--sidebar-width);">
                <div class="offcanvas-header border-bottom border-secondary border-opacity-25 pb-3">
                    <a class="text-decoration-none d-flex align-items-center text-white" href="#">
                        <span class="brand-mark mb-0"><i class="bi bi-buildings-fill"></i></span>
                        <span class="brand-title text-white">Seashore CRM</span>
                    </a>
                    <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body p-0">
                    <div class="sidebar-inner">
                        @await Html.PartialAsync("_Sidebar")
                    </div>
                </div>
            </div>
        }

        @* --- MAIN CONTENT --- *@
        <main class="app-main @(User?.Identity?.IsAuthenticated == true ? "" : "full-width-layout")">
            <div class="app-content">
                @RenderBody()
            </div>
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>