@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Dashboard Overview</h2>
        <p class="text-muted mb-0">Welcome back! Here is what's happening today.</p>
    </div>
    <div>
        <button class="btn btn-light me-2"><i class="bi bi-download me-2"></i>Export</button>
        <button class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>New Project</button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100 p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted fw-semibold mb-1">Total Revenue</p>
                    <h3 class="fw-bold mb-2">$84,590.00</h3>
                    <span class="badge text-bg-success rounded-pill"><i class="bi bi-arrow-up-short"></i> 12.5%</span>
                    <span class="text-muted small ms-1">vs last month</span>
                </div>
                <div class="icon-shape bg-primary-soft">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100 p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted fw-semibold mb-1">Active Clients</p>
                    <h3 class="fw-bold mb-2">1,245</h3>
                    <span class="badge text-bg-success rounded-pill"><i class="bi bi-arrow-up-short"></i> 4.2%</span>
                    <span class="text-muted small ms-1">vs last month</span>
                </div>
                <div class="icon-shape bg-success-soft">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100 p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted fw-semibold mb-1">Pending Deals</p>
                    <h3 class="fw-bold mb-2">38</h3>
                    <span class="badge text-bg-danger rounded-pill"><i class="bi bi-arrow-down-short"></i> 2.1%</span>
                    <span class="text-muted small ms-1">vs last month</span>
                </div>
                <div class="icon-shape bg-warning-soft">
                    <i class="bi bi-briefcase"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100 p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted fw-semibold mb-1">System Health</p>
                    <h3 class="fw-bold mb-2">99.9%</h3>
                    <span class="badge text-bg-secondary rounded-pill">Stable</span>
                </div>
                <div class="icon-shape bg-info-soft">
                    <i class="bi bi-activity"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="card p-0 h-100">
            <div class="card-header d-flex justify-content-between align-items-center bg-white border-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0 text-dark">Recent Transactions</h5>
                <a href="#" class="text-decoration-none text-primary small fw-semibold">View All</a>
            </div>
            <div class="card-body px-4">
                <div class="table-responsive">
                    <table class="table table-modern table-borderless mb-0">
                        <thead>
                            <tr>
                                <th>Client Name</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 40px; height: 40px;">
                                            AC
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-semibold">Acme Corp</p>
                                            <p class="mb-0 text-muted small">john@acmecorp.com</p>
                                        </div>
                                    </div>
                                </td>
                                <td>Oct 24, 2023</td>
                                <td class="fw-semibold">$2,400.00</td>
                                <td><span class="badge-soft-success">Completed</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-light"><i class="bi bi-three-dots"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 40px; height: 40px;">
                                            GL
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-semibold">Global Logistics</p>
                                            <p class="mb-0 text-muted small">sarah@globallog.com</p>
                                        </div>
                                    </div>
                                </td>
                                <td>Oct 22, 2023</td>
                                <td class="fw-semibold">$850.00</td>
                                <td><span class="badge-soft-warning">Pending</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-light"><i class="bi bi-three-dots"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card p-4 h-100">
            <h5 class="fw-bold mb-4 text-dark">Quick Actions</h5>
            <div class="d-grid gap-3">
                <button class="btn btn-outline-secondary d-flex justify-content-start align-items-center p-3 text-start" style="border-radius: 12px;">
                    <div class="icon-shape bg-primary-soft me-3" style="width: 40px; height: 40px; font-size: 1rem;">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                    <div>
                        <p class="mb-0 fw-semibold text-dark">Generate Report</p>
                        <small class="text-muted">Monthly financial summary</small>
                    </div>
                </button>
                <button class="btn btn-outline-secondary d-flex justify-content-start align-items-center p-3 text-start" style="border-radius: 12px;">
                    <div class="icon-shape bg-success-soft me-3" style="width: 40px; height: 40px; font-size: 1rem;">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <div>
                        <p class="mb-0 fw-semibold text-dark">Add New Client</p>
                        <small class="text-muted">Create a new CRM profile</small>
                    </div>
                </button>
            </div>
        </div>
    </div>
</div>