@page
@model Seashore_CRM.Pages.Admin.UserActivities.IndexModel
@{
    ViewData["Title"] = "User Activities";
}

<div class="container-fluid">
    <h4>User Activities</h4>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <input type="text" name="user" value="@Model.UserFilter" class="form-control form-control-sm" placeholder="User name" />
        </div>
        <div class="col-auto">
            <select name="action" class="form-select form-select-sm">
                <option value="">All actions</option>
                <option value="Login" @(Model.ActionFilter=="Login"?"selected":"")>Login</option>
                <option value="Logout" @(Model.ActionFilter=="Logout"?"selected":"")>Logout</option>
                <option value="Created" @(Model.ActionFilter=="Created"?"selected":"")>Created</option>
                <option value="Updated" @(Model.ActionFilter=="Updated"?"selected":"")>Updated</option>
                <option value="Deleted" @(Model.ActionFilter=="Deleted"?"selected":"")>Deleted</option>
            </select>
        </div>
        <div class="col-auto">
            <input type="text" name="entity" value="@Model.EntityFilter" class="form-control form-control-sm" placeholder="Entity" />
        </div>
        <div class="col-auto">
            <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">Filter</button>
        </div>
    </form>

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Time (UTC)</th>
                <th>User</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Entity Id</th>
                <th>Details</th>
                <th>Correlation</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Activities)
            {
                <tr>
                    <td>@a.PerformedAt.ToString("u")</td>
                    <td>@a.UserName (@a.UserId)</td>
                    <td>@a.Action</td>
                    <td>@a.EntityName</td>
                    <td>@a.EntityId</td>
                    <td>@a.Details</td>
                    <td>@a.CorrelationId</td>
                </tr>
            }
        </tbody>
    </table>
</div>
